<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/subtext"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp"
            android:text="+ Add"
            android:textColor="#4F46E5"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/subtext"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_budget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/subtext"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_budget_bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:contentDescription="Budget used"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_bars"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:contentDescription="Last 7 days"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_c3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_c4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
