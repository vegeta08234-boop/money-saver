<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="QuickTheme" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="android:windowSoftInputMode">stateVisible|adjustResize</item>
    </style>
</resources>
